{
  "bar": {
    "centerAnchor": "io.github.thetrueferret.decent-workspaces",
    "layout": {
      "center": [
        {
          "id": "tornikegomareli.spaces",
          "activeClick": "none",
          "activeStyle": "accent",
          "animationSpeed": "normal",
          "animations": false,
          "density": "roomy",
          "dimUnfocused": false,
          "focusedTitle": false,
          "groupApps": true,
          "hideEmpty": true,
          "iconSize": 16,
          "iconStyle": "color",
          "labelStyle": "none",
          "maxIcons": 8,
          "persistentWorkspaces": 5,
          "showApps": "all",
          "showIcons": true
        }
      ],
      "left": [
        {
          "id": "io.github.edgarsilva.hw-monitor",
          "mode": "full",
          "showGauges": false,
          "showValues": true,
          "showClocks": false,
          "ramFormat": "used",
          "padOpacity": 0
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy-philips-hue"
        },
        {
          "id": "io.github.bscott.cliamp"
        }
      ],
      "right": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "gigasolo.omavoice",
          "enabled": true,
          "preset": "podcast",
          "setDefaultSource": true,
          "previousAudioSource": "alsa_input.usb-Generic_USB_Audio-00.analog-stereo"
        },
        {
          "id": "org.omarchy.btrfs-raid-manager"
        },
        {
          "id": "ussego.otoru"
        },
        {
          "id": "iamkxyz.todo"
        },
        {
          "id": "benekuehn.macbook-fans"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "omarchy.clock",
          "birthYear": 2001,
          "format": "yyyy-MM-dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        }
      ]
    },
    "position": "bottom",
    "transparent": true
  },
  "idle": {
    "lock": 1800,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "poster",
      "unlock": "fade",
      "unlockMs": 800,
      "avatar": "/home/fran/Pictures/foto.png"
    },
    {
      "id": "b.okomart",
      "windowMode": "tiled"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
