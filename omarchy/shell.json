{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "birthYear": 2001,
          "format": "yyyy-MM-dd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "lifeExpectancy": 90,
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "io.github.bscott.cliamp"
        }
      ],
      "left": [
        {
          "id": "io.github.thetrueferret.decent-workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.edgarsilva.hw-monitor",
          "mode": "labels"
        },
        {
          "id": "ussego.otoru"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "ssupt.bluetooth-audio"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "io.github.sirjul1337.lock-explorer",
      "design": "poster",
      "unlock": "fade",
      "unlockMs": 800,
      "avatar": "/home/fran/Pictures/fran-alaia.jpg"
    },
    {
      "id": "b.okomart",
      "windowMode": "floating"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "io.github.sirjul1337.lock-explorer"
  ]
}
